# 开发示例配置。生产环境请替换并放到 /etc/wangblog.env（chmod 600）。.env 不会被自动加载。
WB_HOST=127.0.0.1
WB_PORT=8310
WB_SECRET=replace-with-a-long-random-secret-at-least-32-chars
WB_ADMIN_PASSWORD=admin123
WB_DEMO_TOTP=true
# 对外访问地址（用于 RSS / sitemap / 分享链接），如 https://blog.example.com
WB_SITE_URL=
# 空库首次启动时是否导入演示文章
WB_SEED_DEMO=true
# 未命中风控的评论是否免审直接展示
WB_COMMENT_AUTO_APPROVE=false
